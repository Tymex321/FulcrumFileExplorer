{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Fulcrum",
  "version": "1.0.1",
  "identifier": "dev.fulcrum.explorer",
  "build": {
    "beforeDevCommand": "cargo test -p fx-core --quiet && npm run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "cargo test -p fx-core --quiet && npm run build",
    "frontendDist": "../ui/dist"
  },
  "app": {
    "windows": [
      {
        "title": "Fulcrum",
        "width": 1280,
        "height": 820,
        "minWidth": 720,
        "minHeight": 480,
        "resizable": true,
        "decorations": false,
        "transparent": false,
        "theme": "Dark",
        "backgroundColor": "#0B0A10",
        "dragDropEnabled": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: asset: http://asset.localhost; style-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "embedBootstrapper"
      },
      "nsis": {
        "installMode": "perMachine",
        "installerHooks": "./windows/hooks.nsh"
      }
    },
    "shortDescription": "A fast file explorer",
    "longDescription": "Fulcrum is a file explorer for Windows with instant whole-volume search backed by the NTFS master file table.",
    "publisher": "Tymex321",
    "copyright": "Copyright (c) 2026 Tymex321. MIT License.",
    "category": "Utility",
    "homepage": "https://github.com/Tymex321/FulcrumFileExplorer"
  }
}
